# Diisi otomatis oleh Vercel saat Anda menambah Storage (Neon Postgres & Blob):
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Isi manual di Vercel > Settings > Environment Variables:
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# (opsional) kunci yang harus dimasukkan saat membuat akun admin pertama
SETUP_KEY=
